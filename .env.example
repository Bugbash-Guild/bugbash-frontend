# BugBash Frontend 環境変数リファレンス（.env.local にコピーして使う）

# --- バックエンド API（必須） ---
# ブラウザには出ない。/api/* プロキシと OAuth rewrite の転送先。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# 本番でサーバ側だけ別オリジンを使う場合はこちらが優先される（例: Cloud Run 内部 URL）
# BACKEND_ORIGIN=

# --- GitHub App（本番必須） ---
# 未設定だと App 導入リンクが描画されず、PR 追跡＝ゲーム開始経路が存在しなくなる。
# 値は GitHub App の URL 末尾 https://github.com/apps/<この部分>
NEXT_PUBLIC_GITHUB_APP_SLUG=

# --- ゲームアセット（Cloudflare R2。未設定なら絵文字フォールバック） ---
# バックエンドの BUGBASH_ASSETS_BASE_URL と同じ値にする。
NEXT_PUBLIC_ASSETS_BASE_URL=

# --- アセットアップロード用（開発ツール。アプリ実行には不要） ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# R2_BUCKET=
